; ============================================================================
; DSHBar - NSIS installer hooks (electron-builder `nsis.include`)
;
; Purpose
;   Put `dshbar-mcp` on the user's PATH so DSH (and any terminal) can launch
;   the DSHBar MCP server directly with `command: dshbar-mcp`.
;
; Mechanism
;   The MCP server is a STANDALONE NODE PROCESS, NOT the Electron app. It is
;   shipped by electron-builder `build.extraResources` as a self-contained,
;   plain-file tree generated by `scripts/build-mcp-bundle.cjs`:
;       <installDir>\resources\dshbar-mcp\
;           dist\mcp\cli.js
;           dist\shared\*.js
;           vendor\...           (only the runtime closure, named `vendor`)
;   It lives OUTSIDE app.asar on purpose, because plain Node.js cannot read an
;   asar archive. It also bundles its own bare-dependency closure so it does not
;   depend on the project node_modules being present on the target machine.
;
;   The closure is named `vendor` (not `node_modules`) because electron-builder
;   hard-codes a node_modules exclusion into every extraResources FileMatcher,
;   so a `node_modules` folder would be silently dropped from the package. The
;   launcher exports NODE_PATH=<resources>\dshbar-mcp\vendor so Node resolves
;   bare specifiers (zod, @modelcontextprotocol/sdk, ...) from it.
;
;   The launcher itself (<installDir>\resources\dshbar-mcp.cmd) is a regular
;   extraResources file (build/dshbar-mcp.cmd). It resolves a Node-compatible
;   runtime, exports NODE_PATH to the shipped vendor closure and runs
;   `%~dp0dshbar-mcp\dist\mcp\cli.js`. Shipping it as a resource instead of
;   writing it here guarantees the unpacked build and the installed build carry
;   the exact same file, so what we test is what users get.
;
;   We then append <installDir>\resources to HKCU\Environment\Path (user PATH,
;   since the assisted installer defaults to a per-user install) and broadcast
;   WM_SETTINGCHANGE so already-running apps such as DSH pick it up immediately.
;
;   On uninstall we strip our entry from user PATH. The launcher file itself is
;   removed with the rest of the install directory.
;
; electron-builder loads exactly ONE custom script via `nsis.include`, so both
; the install and the uninstall macros live in this single file. A reviewable
; standalone copy of just the uninstall logic is kept in build/uninstaller.nsh
; (kept in sync with this file).
;
; IMPORTANT NSIS CONSTRAINTS (both discovered by actually compiling this file):
;   1. Inside the uninstall section `Call` only accepts function names that
;      start with "un.". Calling an install-side function there fails with
;      "Call must be used with function names starting with "un." in the
;      uninstall section."
;   2. electron-builder compiles the same script twice (once normally, once
;      with BUILD_UNINSTALLER defined) and treats NSIS warnings as errors.
;      A helper that is only used by the installer therefore triggers
;      `warning 6010: install function ... not referenced` during the
;      uninstaller pass. Guard each helper group with BUILD_UNINSTALLER.
;
; Only core NSIS instructions are used (no LogicLib / StrFunc / WinMessages) so
; the file is self-contained and does not clash with electron-builder's script.
; SendMessage uses the numeric constants HWND_BROADCAST=0xFFFF and
; WM_SETTINGCHANGE=0x001A directly.
; ============================================================================

; ---------------------------------------------------------------------------
; Find the 0-based start index of $R1 within $R0.       (installer pass only)
;   Usage: Push <haystack> / Push <needle> / Call DSHBar_FindSubstring / Pop <result>
;   result = index (>= 0) when found, -1 when not found.
; Clobbers $R0, $R1, $R4, $R5, $R6 (restores $R2, $R3).
; ---------------------------------------------------------------------------
!ifndef BUILD_UNINSTALLER
Function DSHBar_FindSubstring
  Pop $R1             ; needle (top of stack)
  Pop $R0             ; haystack
  Push $R2
  Push $R3
  StrLen $R2 $R1      ; needle length
  StrLen $R3 $R0      ; haystack length
  StrCpy $R4 -1       ; default result: not found
  StrCmp $R2 0 fss_found0          ; empty needle -> found at 0
  StrCpy $R5 0        ; i = 0
fss_loop:
  IntOp $R6 $R5 + $R2
  IntCmp $R6 $R3 0 0 fss_notfound  ; if i+len > haylen -> not found
  StrCpy $R4 $R0 $R2 $R5           ; candidate substring
  StrCmp $R4 $R1 fss_found
  IntOp $R5 $R5 + 1
  Goto fss_loop
fss_found0:
  StrCpy $R4 0
  Goto fss_out
fss_found:
  StrCpy $R4 $R5
  Goto fss_out
fss_notfound:
  StrCpy $R4 -1
fss_out:
  Pop $R3
  Pop $R2
  Push $R4            ; return value
FunctionEnd
!endif

; ---------------------------------------------------------------------------
; customInstall - runs after the application files are extracted to $INSTDIR.
; ---------------------------------------------------------------------------
!macro customInstall
  ; ---- 1. make sure the resources folder exists ---------------------------
  CreateDirectory "$INSTDIR\resources"

  ; ---- 2. the dshbar-mcp.cmd launcher -------------------------------------
  ; Shipped as a regular extraResources file, so it already exists here.
  ; Only create a minimal fallback if it is somehow missing.
  IfFileExists "$INSTDIR\resources\dshbar-mcp.cmd" mcp_launcher_ok
  ClearErrors
  FileOpen $0 "$INSTDIR\resources\dshbar-mcp.cmd" w
  IfErrors mcp_write_failed
  FileWrite $0 '@echo off$\r$\n'
  FileWrite $0 'setlocal$\r$\n'
  FileWrite $0 'set "CLI=%~dp0dshbar-mcp\dist\mcp\cli.js"$\r$\n'
  FileWrite $0 'set "NODE_PATH=%~dp0dshbar-mcp\vendor"$\r$\n'
  FileWrite $0 'if exist "%ProgramFiles%\nodejs\node.exe" set "NODE=%ProgramFiles%\nodejs\node.exe"$\r$\n'
  FileWrite $0 'if not defined NODE if exist "%LOCALAPPDATA%\Programs\nodejs\node.exe" set "NODE=%LOCALAPPDATA%\Programs\nodejs\node.exe"$\r$\n'
  FileWrite $0 'if not defined NODE for %%I in (node.exe) do if not defined NODE if not "%%~$PATH:I"=="" set "NODE=%%~$PATH:I"$\r$\n'
  FileWrite $0 'if not defined NODE (echo [dshbar-mcp] ERROR: Node.js 18+ not found. 1>&2 & exit /b 1)$\r$\n'
  FileWrite $0 '"%NODE%" "%CLI%" %*$\r$\n'
  FileWrite $0 'endlocal$\r$\n'
  FileClose $0
  Goto mcp_write_done
mcp_write_failed:
  FileClose $0
mcp_write_done:
mcp_launcher_ok:

  ; ---- 3. add <installDir>\resources to the USER path ---------------------
  ReadRegStr $1 HKCU "Environment" "Path"
  StrCpy $2 "$INSTDIR\resources"

  ; skip if it is already there (e.g. re-install / upgrade)
  Push $1
  Push $2
  Call DSHBar_FindSubstring
  Pop $3
  StrCmp $3 -1 mcp_append
  Goto mcp_path_done
mcp_append:
  StrCmp $1 "" mcp_empty mcp_notempty
mcp_empty:
  WriteRegStr HKCU "Environment" "Path" "$2"
  Goto mcp_broadcast
mcp_notempty:
  WriteRegStr HKCU "Environment" "Path" "$2;$1"
  Goto mcp_broadcast
mcp_broadcast:
  ; let running apps (DSH, Explorer, terminals) pick up the new PATH
  SendMessage 0xFFFF 0x001A 0 "STR:Environment" /TIMEOUT=500
mcp_path_done:
!macroend

; ---------------------------------------------------------------------------
; Uninstaller helpers — must be named un.* so `Call` is legal in this section.
; ---------------------------------------------------------------------------
!ifdef BUILD_UNINSTALLER
Function un.DSHBar_FindSubstring
  Pop $R1             ; needle
  Pop $R0             ; haystack
  Push $R2
  Push $R3
  StrLen $R2 $R1
  StrLen $R3 $R0
  StrCpy $R4 -1
  StrCmp $R2 0 un_fss_found0
  StrCpy $R5 0
un_fss_loop:
  IntOp $R6 $R5 + $R2
  IntCmp $R6 $R3 0 0 un_fss_notfound
  StrCpy $R4 $R0 $R2 $R5
  StrCmp $R4 $R1 un_fss_found
  IntOp $R5 $R5 + 1
  Goto un_fss_loop
un_fss_found0:
  StrCpy $R4 0
  Goto un_fss_out
un_fss_found:
  StrCpy $R4 $R5
  Goto un_fss_out
un_fss_notfound:
  StrCpy $R4 -1
un_fss_out:
  Pop $R3
  Pop $R2
  Push $R4
FunctionEnd

Function un.DSHBar_PathRemoveEntry
  Pop $1              ; entry (needle)
  Pop $0              ; path value (haystack)
  Push $2
  Push $3
  Push $4
  Push $5
  StrCpy $8 ""        ; accumulator
  StrCpy $7 "$0;"     ; working copy with a trailing separator
un_pre_loop:
  StrLen $9 $7
  StrCmp $9 0 un_pre_done
  Push $7
  Push ";"
  Call un.DSHBar_FindSubstring
  Pop $6
  StrCmp $6 -1 un_pre_done
  StrCpy $2 $7 $6
  IntOp $9 $6 + 1
  StrCpy $7 $7 "" $9
  StrCmp $2 $1 un_pre_loop
  StrCpy $8 "$8$2;"
  Goto un_pre_loop
un_pre_done:
  StrLen $9 $8
  StrCmp $9 0 un_pre_empty
  IntOp $9 $9 - 1
  StrCpy $8 $8 $9
un_pre_empty:
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Push $8
FunctionEnd
!endif

; ---------------------------------------------------------------------------
; customUnInstall - runs in the uninstaller.
; ---------------------------------------------------------------------------
!macro customUnInstall
  ; ---- 1. remove our entry from the USER path ----------------------------
  ReadRegStr $0 HKCU "Environment" "Path"
  StrCmp $0 "" mcp_un_path_done
  Push $0
  Push "$INSTDIR\resources"
  Call un.DSHBar_PathRemoveEntry
  Pop $1
  WriteRegStr HKCU "Environment" "Path" "$1"
  SendMessage 0xFFFF 0x001A 0 "STR:Environment" /TIMEOUT=500
mcp_un_path_done:
!macroend
